# Save as /etc/systemd/system/nammet-api.service on the recipe VM
[Unit]
Description=nammet recipe import API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nammet
Group=nammet
WorkingDirectory=/opt/nammet-api
EnvironmentFile=/etc/nammet/api.env
ExecStart=/usr/bin/node /opt/nammet-api/server.js
Restart=on-failure
RestartSec=5

# Hardening: the service can only write to the recipes and photos folders, the
# generated theme files, and its own data folder (users and admin-page settings)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/nammet/recipes /var/www/nammet/photos /var/www/nammet/theme /var/lib/nammet
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0022

[Install]
WantedBy=multi-user.target
