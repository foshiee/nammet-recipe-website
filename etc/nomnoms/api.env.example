# Copy to /etc/nomnoms/api.env on the recipe VM:
#   sudo install -m 0640 -o root -g nomnoms api.env.example /etc/nomnoms/api.env
# then fill in the API key. Never commit the real file.

# Needed only for PDFs, photos, plain text and web pages without recipe markup.
# Recipe .json files and most recipe websites import without it.
ANTHROPIC_API_KEY=

# Model and effort used for those imports. claude-opus-5-5 is stronger on hard-to-read
# photos and messy PDFs, at about twice the price.
MODEL=claude-sonnet-5-5
EFFORT=medium
# Retry a refused request on another model automatically (server-side fallback).
# Set to false if you switch MODEL to a Haiku model, which doesn't support it.
AI_FALLBACKS=true

RECIPES_DIR=/var/www/recipes/recipes
USERS_FILE=/var/lib/nomnoms/users.json

HOST=127.0.0.1
PORT=3000

# Browsers only send the session cookie over HTTPS. Keep this on: Traefik serves the site over HTTPS.
COOKIE_SECURE=true
SESSION_HOURS=168

MAX_UPLOAD_MB=20
MAX_FETCH_MB=5
