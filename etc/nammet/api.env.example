# Copy to /etc/nammet/api.env on the recipe VM:
#   sudo install -m 0640 -o root -g nammet api.env.example /etc/nammet/api.env
# then fill in the API key. Never commit the real file.

# Needed only for PDFs, photos, plain text and web pages without recipe markup.
# Recipe .json files and most recipe websites import without it.
# You can leave this empty and add the key on the admin page instead. A key, model or
# effort saved on the admin page takes priority over the values in this file.
ANTHROPIC_API_KEY=

# Model and effort used for those imports. claude-haiku-5-5 costs about a twentieth as much;
# claude-opus-5-5 is stronger on hard-to-read photos and messy PDFs, at about twice the price.
MODEL=claude-sonnet-5-5
EFFORT=medium
# Retry a refused request on another model automatically (server-side fallback).
# Haiku models don't support it, so it's skipped for them whatever this says.
AI_FALLBACKS=true

RECIPES_DIR=/var/www/nammet/recipes
PHOTOS_DIR=/var/www/nammet/photos
USERS_FILE=/var/lib/nammet/users.json
# Admin page settings (may hold the API key), and where the generated theme files go
SETTINGS_FILE=/var/lib/nammet/settings.json
THEME_DIR=/var/www/nammet/theme

HOST=127.0.0.1
PORT=3000

# Browsers only send the session cookie over HTTPS. Keep this on: Traefik serves the site over HTTPS.
COOKIE_SECURE=true
SESSION_HOURS=168

MAX_UPLOAD_MB=20
MAX_FETCH_MB=5

# Public demo with a shared admin login. Visitors can import, edit and restyle the site
# to try it, but nothing they write is kept: saving recipes and photos, the site name and
# icon, users, passwords, the API key, model and effort are all refused. Leave it off otherwise.
DEMO_MODE=false
# Shown on the sign-in screen when set (up to 200 characters), for example the demo
# login. Anyone can read it.
DEMO_HINT=
